# Em produção: APP_ENV=production, APP_DEBUG=false e APP_URL com o domínio
# real e https. Com APP_DEBUG ligado, qualquer erro mostra trecho de código,
# variáveis de ambiente e caminho de arquivo para quem estiver na tela.
APP_NAME="HC Brain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite dá conta do desenvolvimento. Em produção, com mais de uma pessoa
# escrevendo ao mesmo tempo, troque por mysql e preencha as linhas abaixo.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hc_brain
# DB_USERNAME=hc_brain
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Em produção o cookie de sessão só deve trafegar por https.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@healthcare.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- HC Brain ---------------------------------------------------------------
# Senha da equipe criada por `db:seed`. Só existe em desenvolvimento: sem ela
# o seeder gera senhas aleatórias, e é assim que precisa ficar em produção.
HC_SENHA_SEMEADA=senha-de-desenvolvimento

# Acesso que abre um ambiente publicado, criado no boot pelo `hc:preparar`.
# Vazio em desenvolvimento, onde a equipe semeada e o `hc:acesso` bastam. Em
# produção estas variáveis mandam na senha: trocá-las é como se recupera a
# entrada num servidor sem terminal.
HC_ACESSO_EMAIL=
HC_ACESSO_SENHA=
HC_ACESSO_NOME=Administrador

# Onde os documentos enviados são guardados. Com mais de uma instância da
# aplicação isto precisa ser um disco compartilhado (s3), senão cada servidor
# enxerga só os arquivos que ele mesmo recebeu.
HC_DISCO_DOCUMENTOS=local
HC_TAMANHO_MAXIMO_DOCUMENTO=20480
